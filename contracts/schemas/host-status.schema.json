{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.enterprise-design-agent.local/contracts/host-status.schema.json",
  "title": "HostStatus",
  "description": "Health / state heartbeat exchanged in both directions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["state"],
  "properties": {
    "state": {
      "enum": ["starting", "ready", "busy", "error", "stopped"]
    },
    "documentId": {
      "type": "string",
      "description": "Id of the active document, when any."
    },
    "documentName": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Revision of the active document."
    },
    "uptimeMs": {
      "type": "integer",
      "minimum": 0
    },
    "detail": {
      "type": "string",
      "description": "Optional human-readable detail (e.g. error message in error state)."
    }
  }
}
