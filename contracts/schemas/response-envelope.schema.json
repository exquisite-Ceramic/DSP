{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.enterprise-design-agent.local/contracts/response-envelope.schema.json",
  "title": "ResponseEnvelope",
  "description": "Unified response envelope (spec A.8 / §26.1). contract_version is part of the wire contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "status"],
  "properties": {
    "contract_version": { "type": "string", "const": "1.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["OK", "PENDING", "ERROR"] },
    "correlation_ids": { "type": "array", "items": { "type": "string" } },
    "snapshot_ref": { "type": "string" },
    "operation_ref": { "$ref": "response-envelope.schema.json#/definitions/asyncOperationRef" },
    "result": { "type": "object" },
    "error": { "$ref": "host-error.schema.json" }
  },
  "definitions": {
    "asyncOperationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["INTERACTION_SESSION", "RECONSTRUCTION_JOB", "EXECUTION_JOB", "OTHER"] },
        "id": { "type": "string" }
      }
    }
  }
}
