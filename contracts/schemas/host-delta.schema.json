{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.enterprise-design-agent.local/contracts/host-delta.schema.json",
  "title": "HostDelta",
  "description": "Lightweight change stream (spec §12.3 / §26.8): revisions bracket the change; refs grouped by change kind.",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision_before", "revision_after"],
  "properties": {
    "revision_before": { "type": "integer", "minimum": 0 },
    "revision_after": {
      "type": "integer",
      "minimum": 0,
      "description": "MUST be >= revision_before."
    },
    "added": {
      "type": "array",
      "items": { "$ref": "host-command.schema.json#/definitions/entityRef" }
    },
    "modified": {
      "type": "array",
      "items": { "$ref": "host-command.schema.json#/definitions/entityRef" }
    },
    "erased": {
      "type": "array",
      "items": { "$ref": "host-command.schema.json#/definitions/entityRef" }
    }
  }
}
