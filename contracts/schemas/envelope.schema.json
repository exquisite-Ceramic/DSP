{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.enterprise-design-agent.local/contracts/envelope.schema.json",
  "title": "RequestEnvelope",
  "description": "Unified request envelope (spec A.8 / §26.1). contract_version is part of the wire contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "payload"],
  "properties": {
    "contract_version": { "type": "string", "const": "1.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string" },
    "project_id": { "type": "string" },
    "actor_context": { "type": "object" },
    "correlation_ids": { "type": "array", "items": { "type": "string" } },
    "deadline_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string" },
    "payload": { "type": "object" }
  }
}
