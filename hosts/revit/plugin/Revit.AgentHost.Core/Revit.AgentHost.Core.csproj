<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- canonical / Host consumers 默认只看到 net8；Task 8 compatibility lane 显式 opt-in net10。 -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(DspEnableNet10Compatibility)' == 'true'">net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
