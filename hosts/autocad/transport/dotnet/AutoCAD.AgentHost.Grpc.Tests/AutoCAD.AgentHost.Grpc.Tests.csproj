<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>AutoCAD.AgentHost.Grpc.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- 测试客户端必须与 Grpc.AspNetCore 的运行时依赖下界对齐，避免 restore 出现 NU1605 downgrade。 -->
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoCAD.AgentHost.Grpc\AutoCAD.AgentHost.Grpc.csproj" />
  </ItemGroup>

</Project>
